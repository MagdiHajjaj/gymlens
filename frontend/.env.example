VITE_API_BASE_URL=http://127.0.0.1:8000
# See docs/auth0-setup.md. Public SPA configuration; never add a client secret.
# Bare tenant domain, for example dev-example.us.auth0.com (no https://).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# Must match your Auth0 API Identifier and backend AUTH0_AUDIENCE.
VITE_AUTH0_AUDIENCE=
